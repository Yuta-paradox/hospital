# Database name (any name; created automatically)
MONGODB_DB=bedagent
# Generate with: openssl rand -hex 32
AUTH_SECRET=base64:WxUDzGADYNS6ujGzm57FffRXIFN/tlzYabs/is7LFYE=
# Any long secret you choose; unlocks /platform (verifier) and /dispatch (control room)
PLATFORM_KEY=roshan

# ---------- EMAIL VERIFICATION (required in production) ----------
